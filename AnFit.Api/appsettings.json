{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "SmtpSettings": {
    "Host": "smtp.gmail.com",
    "Port": 587,
    "SenderName": "AnFit Assistant",
    "SenderEmail": "your_email@gmail.com",
    "Username": "your_email@gmail.com",
    "Password": "YOUR_GMAIL_APP_PASSWORD"
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=YOUR_SERVER;Database=AnFitDB;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "Jwt": {
    "SecretKey": "REPLACE_WITH_YOUR_SECRET_KEY_MIN_32_CHARACTERS_LONG",
    "Issuer": "AnFit.API",
    "Audience": "AnFit.Client",
    "AccessTokenExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 7
  },
  "Garmin": {
    "ConsumerKey": "YOUR_GARMIN_CONSUMER_KEY",
    "ConsumerSecret": "YOUR_GARMIN_CONSUMER_SECRET",
    "RequestTokenUrl": "https://connectapi.garmin.com/oauth-service/oauth/request_token",
    "AccessTokenUrl": "https://connectapi.garmin.com/oauth-service/oauth/access_token",
    "AuthorizeUrl": "https://connect.garmin.com/oauthConfirm",
    "BridgeBaseUrl": "http://localhost:8001"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "https://localhost:3000",
      "http://localhost:5173"
    ]
  }
}
